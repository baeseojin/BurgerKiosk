<UserControl x:Class="BurgerKiosk.Views.OptionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:behaviors="clr-namespace:BurgerKiosk.Behaviors"
 Background="Transparent">

    <UserControl.Resources>

        
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#332820"/>
            <Setter Property="BorderBrush" Value="#EBDDD1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="12,8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Outer"
                                        Property="Background"
                                        Value="#FFF1E3"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Outer"
                                        Property="Background"
                                        Value="#FFE4C6"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Outer"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="PrimaryAction"
               TargetType="Button"
               BasedOn="{StaticResource ChoiceButton}">

            <Setter Property="Background" Value="#D9652E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Outer"
                                        Property="Background"
                                        Value="#C95724"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Outer"
                                        Property="Background"
                                        Value="#B94A1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>

        
        <Border Background="#A6000000"/>

        
        <Border Width="420"
                MaxHeight="640"
                Margin="14"
                Background="#FFFBF7"
                CornerRadius="23"
                BorderBrush="#F0E2D6"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid Margin="20,19,20,18">

                <Grid.RowDefinitions>
                    
                    <RowDefinition Height="Auto"/>

                    
                    <RowDefinition Height="*"/>

                    
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                
                
                

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,15">

                    <Border Background="#FFF0DE"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            Padding="12,5"
                            Margin="0,0,0,12">

                        <TextBlock Text="메뉴 옵션 선택"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#C26532"/>
                    </Border>

                    <TextBlock Text="{Binding SelectedMenuName}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#332820"/>

                    <TextBlock Text="원하는 구성을 선택해 주세요"
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="#9B8474"
                               Margin="0,7,0,0"/>

                </StackPanel>

                
                
                

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              PanningDeceleration="0.001"
                              PanningRatio="1"
                              CanContentScroll="False"
                              behaviors:ScrollViewerDragBehavior.EnableMouseDrag="True">

                    <StackPanel>

                        
                        
                        

                        <StackPanel Visibility="{Binding IsChoosingBurgerType, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="어떤 구성으로 드릴까요?"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#382B23"
                                       Margin="0,6,0,14"/>

                            
                            <Button Style="{StaticResource ChoiceButton}"
                                    Command="{Binding SelectSingleCommand}"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="단품"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#332820"/>

                                        <TextBlock Text="버거만 간편하게"
                                                   FontSize="12"
                                                   Foreground="#978578"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SinglePrice, StringFormat={}{0:N0}원}"
                                               FontSize="17"
                                               Foreground="#D9652E"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            
                            <Button Style="{StaticResource ChoiceButton}"
                                    Command="{Binding SelectSetCommand}"
                                    Background="#FFF5EB">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="세트"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#332820"/>

                                        <TextBlock Text="사이드 + 음료 포함"
                                                   FontSize="12"
                                                   Foreground="#978578"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SetPrice, StringFormat={}{0:N0}원}"
                                               FontSize="17"
                                               Foreground="#D9652E"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                        </StackPanel>

                        
                        
                        

                        <StackPanel Visibility="{Binding IsChoosingSetOptions, Converter={StaticResource BoolToVisibility}}">

                            
                            <TextBlock Text="01  사이드 선택"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#382B23"
                                       Margin="0,3,0,11"/>

                            <UniformGrid Columns="2"
                                         Margin="0,0,0,10">

                                
                                <Button Content="감자튀김"
                                        Margin="0,0,5,0"
                                        Command="{Binding SelectSideCommand}"
                                        CommandParameter="감자튀김">

                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ChoiceButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}"
                                                             Value="감자튀김">

                                                    <Setter Property="Background"
                                                            Value="#FFE8CE"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#D9652E"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                
                                <Button Content="치즈스틱 (+500원)"
                                        Margin="5,0,0,0"
                                        Command="{Binding SelectSideCommand}"
                                        CommandParameter="치즈스틱">

                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ChoiceButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSide}"
                                                             Value="치즈스틱">

                                                    <Setter Property="Background"
                                                            Value="#FFE8CE"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#D9652E"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </UniformGrid>

                            <TextBlock Text="{Binding SelectedSide, StringFormat='선택: {0}'}"
                                       Foreground="#BD6735"
                                       FontSize="12"
                                       Margin="3,0,0,19"/>

                            
                            <TextBlock Text="02  음료 선택"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#382B23"
                                       Margin="0,0,0,11"/>

                            <UniformGrid Columns="2"
                                         Margin="0,0,0,10">

                                
                                <Button Content="콜라"
                                        Margin="0,0,5,0"
                                        Command="{Binding SelectDrinkCommand}"
                                        CommandParameter="콜라">

                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ChoiceButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDrink}"
                                                             Value="콜라">

                                                    <Setter Property="Background"
                                                            Value="#FFE8CE"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#D9652E"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                
                                <Button Content="사이다"
                                        Margin="5,0,0,0"
                                        Command="{Binding SelectDrinkCommand}"
                                        CommandParameter="사이다">

                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ChoiceButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDrink}"
                                                             Value="사이다">

                                                    <Setter Property="Background"
                                                            Value="#FFE8CE"/>
                                                    <Setter Property="BorderBrush"
                                                            Value="#D9652E"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </UniformGrid>

                            <TextBlock Text="{Binding SelectedDrink, StringFormat='선택: {0}'}"
                                       Foreground="#BD6735"
                                       FontSize="12"
                                       Margin="3,0,0,12"/>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                
                
                

                <StackPanel Grid.Row="2"
                            Margin="0,12,0,0">

                    
                    <StackPanel Visibility="{Binding IsChoosingSetOptions, Converter={StaticResource BoolToVisibility}}">

                        
                        <Border Background="#FFF0E1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,12">

                            <StackPanel>

                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="세트 기본 가격"
                                               FontSize="12"
                                               Foreground="#806E61"/>

                                    <TextBlock Text="{Binding SetPrice, StringFormat={}{0:N0}원}"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               Foreground="#382B23"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="옵션 추가금"
                                               FontSize="12"
                                               Foreground="#806E61"/>

                                    <TextBlock Text="{Binding OptionExtraPrice, StringFormat={}{0:+0;-0;0}원}"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               Foreground="#382B23"/>
                                </Grid>

                                <Border Height="1"
                                        Background="#E8D2BD"
                                        Margin="0,0,0,10"/>

                                <Grid>
                                    <TextBlock Text="총 결제 금액"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#382B23"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding FinalSetPrice, StringFormat={}{0:N0}원}"
                                               HorizontalAlignment="Right"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               Foreground="#D9652E"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                        
                        <Button Content="장바구니에 담기"
                                Style="{StaticResource PrimaryAction}"
                                Command="{Binding ConfirmSetCommand}"
                                Height="58"/>

                    </StackPanel>

                    
                    <Button Content="취소하고 돌아가기"
                            Style="{StaticResource ChoiceButton}"
                            MinHeight="48"
                            Margin="0,10,0,0"
                            Background="#F2EBE5"
                            FontSize="14"
                            Command="{Binding CancelOptionCommand}"/>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
