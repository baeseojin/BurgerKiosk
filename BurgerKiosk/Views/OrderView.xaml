<UserControl x:Class="BurgerKiosk.Views.OrderView"
             xmlns:behaviors="clr-namespace:BurgerKiosk.Behaviors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF7F2">
    <UserControl.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F6EFE7"/>
            <Setter Property="Foreground" Value="#5D4B3D"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuCardStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EDE5DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFF4E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFE8CD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FFF7F1"/>
            <Setter Property="Foreground" Value="#65442E"/>
            <Setter Property="BorderBrush" Value="#E6D2C1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFE6CE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="238"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="19,5,19,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="맛있는 메뉴를 골라보세요" FontSize="19" FontWeight="Bold" Foreground="#302820"/>
                <TextBlock Text="원하는 메뉴를 터치해 주문해 주세요" FontSize="11" Foreground="#9A8A7B" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#FFF0E1" CornerRadius="16" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="{Binding OrderType}" FontSize="11" FontWeight="Bold" Foreground="#995019"/>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="11,2,11,7">
            <Button Content="추천메뉴" Command="{Binding SelectCategoryCommand}" CommandParameter="추천메뉴">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategory}" Value="추천메뉴">
                                <Setter Property="Background" Value="#E86C32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="버거" Command="{Binding SelectCategoryCommand}" CommandParameter="버거">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategory}" Value="버거">
                                <Setter Property="Background" Value="#E86C32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="세트" Command="{Binding SelectCategoryCommand}" CommandParameter="세트">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategory}" Value="세트">
                                <Setter Property="Background" Value="#E86C32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="사이드" Command="{Binding SelectCategoryCommand}" CommandParameter="사이드">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategory}" Value="사이드">
                                <Setter Property="Background" Value="#E86C32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="음료" Command="{Binding SelectCategoryCommand}" CommandParameter="음료">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategory}" Value="음료">
                                <Setter Property="Background" Value="#E86C32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </UniformGrid>

        
        <Border Grid.Row="2" Background="White" CornerRadius="20" Margin="12,4,12,9" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding SelectedCategory}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#302720"
                           Margin="6,4,0,10"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              PanningDeceleration="0.001"
                              PanningRatio="1"
                              behaviors:ScrollViewerDragBehavior.EnableMouseDrag="True">
                    <ItemsControl ItemsSource="{Binding FilteredMenus}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="2,0,2,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MenuCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSoldOut}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.58"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding ImagePath}" Width="108" Height="73"
                                               Stretch="Uniform" Margin="0,0,0,7"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#312922" MaxHeight="32"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0}원}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#DF5E28"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="품절 · 주문 불가" Foreground="#C43D2B"
                                                   FontSize="12" FontWeight="Bold" TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSoldOut}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        
        <Grid Grid.Row="3" Margin="12,0,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EDE5DC" BorderThickness="1" CornerRadius="18" Margin="0,0,0,9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#FFF3E6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="내 장바구니" FontSize="15" FontWeight="Bold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalItemCount, StringFormat={}{0}개}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat={}{0:N0}원}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#D95C22" FontSize="18" FontWeight="Bold"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  PanningDeceleration="0.001"
                                  PanningRatio="1"
                                  behaviors:ScrollViewerDragBehavior.EnableMouseDrag="True"
                                  Padding="6,4">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E4DED8" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="83"/>
                                                <ColumnDefinition Width="102"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding OptionDescription}" FontSize="10"
                                                           Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Grid Grid.Column="1" Width="79" Height="28" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="27"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="−" Style="{StaticResource MiniActionButtonStyle}"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="+" Style="{StaticResource MiniActionButtonStyle}"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TotalPrice, StringFormat={}{0:N0}원}"
                                                       FontSize="13" FontWeight="Bold" TextAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Grid.Column="3" Content="삭제" Width="43" Height="28"
                                                    VerticalAlignment="Center" Style="{StaticResource MiniActionButtonStyle}"
                                                    Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            

            <Button Grid.Row="1"
                    Content="결제하기"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#EA6A30"
                    BorderThickness="0"
                    Command="{Binding CheckoutCommand}"
                    IsEnabled="{Binding CanCheckout}"
                    Margin="0,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PayBorder" CornerRadius="16"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PayBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PayBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
