<UserControl x:Class="BurgerKiosk.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#FFFBF7">

    <UserControl.Resources>
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F0E3D7"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
       Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="22" Padding="14">

                            <ContentPresenter
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
         Property="Background" Value="#FFF1E2"/>
                                <Setter TargetName="Card"
         Property="BorderBrush" Value="#F4BE8D"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card"
         Property="Background" Value="#FFE5C9"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card"
         Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1"
   Margin="24,0" MaxWidth="440">

            <Border HorizontalAlignment="Center"
    Background="#FFF0DE"
    CornerRadius="18"
    Padding="16,7"
    Margin="0,0,0,25">

                <TextBlock Text="FRESH &amp; DELICIOUS"
     FontSize="12" FontWeight="Bold"
     Foreground="#C86731"/>
            </Border>

            <TextBlock Text="어서 오세요!"
    TextAlignment="Center"
    FontSize="34" FontWeight="Bold"
    Foreground="#342820"/>

            <TextBlock Text="{Binding Title}"
    TextAlignment="Center"
    TextWrapping="Wrap"
    FontSize="17" Foreground="#8E7A6C"
    Margin="0,10,0,35"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                
                <Button Grid.Column="0"
     Style="{StaticResource ChoiceCard}"
     Height="225"
     IsEnabled="{Binding CanStartOrder}"
     Command="{Binding SelectOrderTypeCommand}"
     CommandParameter="매장에서 식사">

                    <StackPanel VerticalAlignment="Center"
      HorizontalAlignment="Center">

                        <Border Width="78" Height="78"
       Background="#FFF0DE"
       CornerRadius="39"
       Margin="0,0,0,18">

                            <TextBlock Text="🍔" FontSize="38"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="매장에서 식사"
       HorizontalAlignment="Center"
       FontWeight="Bold"
       FontSize="17"
       Foreground="#342820"/>

                        <TextBlock Text="매장 이용"
       HorizontalAlignment="Center"
       FontSize="12"
       Foreground="#9C887B"
       Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                
                <Button Grid.Column="2"
     Style="{StaticResource ChoiceCard}"
     Height="225"
     IsEnabled="{Binding CanStartOrder}"
     Command="{Binding SelectOrderTypeCommand}"
     CommandParameter="포장">

                    <StackPanel VerticalAlignment="Center"
      HorizontalAlignment="Center">

                        <Border Width="78" Height="78"
       Background="#FFF0DE"
       CornerRadius="39"
       Margin="0,0,0,18">

                            <TextBlock Text="🛍" FontSize="38"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="포장"
       HorizontalAlignment="Center"
       FontWeight="Bold"
       FontSize="17"
       Foreground="#342820"/>

                        <TextBlock Text="가져가기"
       HorizontalAlignment="Center"
       FontSize="12"
       Foreground="#9C887B"
       Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock
    Text="이용하실 방법을 터치해 주세요"
    HorizontalAlignment="Center"
    FontSize="13"
    Foreground="#A99484"
    Margin="0,26,0,0"/>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRecoveryCheckFailed, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StartupStatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="13" Foreground="#8E7A6C"/>
                <Button Content="다시 연결" Command="{Binding ResumePaymentCommand}"
                        HorizontalAlignment="Center" Padding="18,8" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
