<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BurgerKiosk.AdminDashboardWindow" Background="#FAF7F2" Loaded="Window_Loaded">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="#000000"/>

        <Style x:Key="SoftCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#ECE3DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#EC6B30"/>
            <Setter Property="BorderBrush" Value="#D65B23"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.93"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Foreground" Value="#4E433C"/>
            <Setter Property="Background" Value="#F6F2EC"/>
            <Setter Property="BorderBrush" Value="#E3D9CF"/>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#C7443A"/>
            <Setter Property="BorderBrush" Value="#AF362D"/>
        </Style>

        <Style x:Key="ToolbarSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="ToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#E6DDD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0E8E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F0E8E0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#FCF9F6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F3EE"/>
            <Setter Property="Foreground" Value="#463B35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E8DED4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#302820"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF1E5"/>
                    <Setter Property="Foreground" Value="#302820"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#E3D8CE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFCFA"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E3D8CE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFCFA"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="#E3D8CE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFCFA"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter Grid.Row="1" Margin="0,10,0,0" ContentSource="SelectedContent" TextElement.Foreground="#302820" KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="3,8"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F5047"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#F3EEE8" BorderBrush="#E5DDD3" BorderThickness="1" CornerRadius="10" Margin="2,0" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="TabHeaderText" Text="{TemplateBinding Header}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EC6B30"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#D65B23"/>
                                <Setter TargetName="TabHeaderText" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SoftCardStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ADMIN · 매장 관리"
                           FontSize="19" FontWeight="Bold" Foreground="#302820"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Grid.Column="1" Content="관리자 종료" Click="Close_Click"
                        Style="{StaticResource PrimaryActionButton}"
                        MinWidth="90" Width="96" Height="38" FontSize="12"
                        VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SoftCardStyle}" Padding="8">
            <TabControl FontSize="13">
                <TabItem Header="재고 관리">
                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <Button x:Name="RefreshButton" Content="갱신" DockPanel.Dock="Right" Click="RefreshButton_Click" Style="{StaticResource ToolbarSecondaryButton}"/>
                            <TextBlock Text="상품 재고 현황" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="StockGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="StockGrid_SelectionChanged" CanUserAddRows="False" CanUserDeleteRows="False" FontSize="14" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="36"/>
                                <DataGridTextColumn Header="상품명" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="58"/>
                                <DataGridTextColumn Header="재고" Binding="{Binding StockQuantity}" Width="52"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="64"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Style="{StaticResource SoftCardStyle}" Padding="10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="SelectedProductText" Text="상품을 선택하면 이곳에서 재고를 수정할 수 있습니다." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,5" Grid.Row="0"/>
                                <TextBox x:Name="StockQuantityBox" Grid.Column="1" Margin="0,0,0,8" VerticalContentAlignment="Center" Grid.Row="1" Height="36"/>
                                <Button x:Name="SaveStockButton" Content="재고 변경 저장" Click="SaveStockButton_Click" Style="{StaticResource PrimaryActionButton}" Grid.Row="2" HorizontalAlignment="Stretch" MinWidth="0"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#855D43"/>
                    </Grid>
                </TabItem>

                <TabItem Header="메뉴 관리">
                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="80"/>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="상품 관리" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" Grid.Row="0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1"><Button x:Name="MenuRefreshButton" Content="갱신" Click="MenuRefresh_Click" Style="{StaticResource ToolbarSecondaryButton}" Margin="0,0,10,0" MinWidth="90" Width="90" FontSize="12"/>
                                <Button x:Name="NewMenuButton" Content="새 상품" Click="MenuNew_Click" Style="{StaticResource ToolbarPrimaryButton}" MinWidth="90" Width="90" FontSize="12"/>
                            </StackPanel></Grid>
                        <DataGrid x:Name="MenuGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="MenuGrid_SelectionChanged" FontSize="12" RowHeight="35">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="32"/>
                                <DataGridTextColumn Header="상품명" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="52"/>
                                <DataGridTextColumn Header="가격" Binding="{Binding Price}" Width="65"/>
                                <DataGridCheckBoxColumn Header="판매" Binding="{Binding IsAvailable}" Width="42"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Style="{StaticResource SoftCardStyle}" Padding="16" Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="상품 정보" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="상품명" Margin="0,0,0,6"/>
                                            <TextBox x:Name="MenuNameBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBlock Text="카테고리" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="MenuCategoryBox" SelectedIndex="0" SelectionChanged="MenuCategoryChanged">
                                                <ComboBoxItem Content="버거"/>
                                                <ComboBoxItem Content="세트"/>
                                                <ComboBoxItem Content="사이드"/>
                                                <ComboBoxItem Content="음료"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                            <TextBlock Text="가격 (원)" Margin="0,0,0,6"/>
                                            <TextBox x:Name="MenuPriceBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                            <TextBlock x:Name="MenuStockLabel" Text="새 상품 초기 재고 (수정은 재고 관리 탭)" Margin="0,0,0,6"/>
                                            <TextBox x:Name="MenuStockBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Margin="0,0,0,8">
                                            <TextBlock Text="설명" Margin="0,0,0,6"/>
                                            <TextBox x:Name="MenuDescriptionBox"/>
                                            <TextBlock Text="세트에 연결할 버거" Margin="0,8,0,6"/>
                                            <ComboBox x:Name="MenuBurgerBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="5" Margin="0,0,0,8">
                                            <TextBlock Text="이미지 HTTPS URL" Margin="0,0,0,6"/>
                                            <TextBox x:Name="MenuImageBox"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox x:Name="MenuAvailableBox" Content="판매 중" IsChecked="True" Margin="0,0,20,0"/>
                                        <CheckBox x:Name="MenuRecommendedBox" Content="추천 메뉴"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <UniformGrid Grid.Row="3" Margin="0,12,0,0" Columns="3" Rows="1">
                            <Button x:Name="MenuSaveButton" Content="상품 저장" Click="MenuSave_Click" Style="{StaticResource PrimaryActionButton}" Margin="2,0" MinWidth="0" Width="Auto" FontSize="12" Padding="2,0"/>
                            <Button x:Name="MenuStopButton" Content="판매 중지" Click="MenuStop_Click" Style="{StaticResource SecondaryActionButton}" Margin="2,0" MinWidth="0" Width="Auto" FontSize="12" Padding="2,0"/>
                            <Button x:Name="MenuDeleteButton" Content="영구 삭제" Click="MenuDelete_Click" Style="{StaticResource DangerActionButton}" Margin="2,0" MinWidth="0" Width="Auto" FontSize="12" Padding="2,0"/>
                        </UniformGrid>
                        <TextBlock x:Name="MenuStatusText" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#855D43"/>
                    </Grid>
                </TabItem>

                <TabItem Header="주문 통계">
                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,6,8"><TextBlock Text="시작일" FontSize="12" Margin="0,0,0,4"/><DatePicker x:Name="StatsStartDate" Width="Auto"/>
                            </StackPanel><StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,6,8"><TextBlock Text="종료일" FontSize="12" Margin="0,0,0,4"/><DatePicker x:Name="StatsEndDate" Width="Auto"/>
                            </StackPanel><Button x:Name="StatsSearchButton" Content="통계 조회" Click="StatsSearch_Click" Style="{StaticResource ToolbarPrimaryButton}" MinWidth="0" HorizontalAlignment="Stretch" Grid.ColumnSpan="2" Grid.Row="1"/>
                        </Grid><UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,12">
                            <Border Style="{StaticResource SoftCardStyle}" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="조회 기간 주문 건수" Foreground="#777"/>
                                    <TextBlock x:Name="StatsOrderCount" Text="-" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SoftCardStyle}" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="조회 기간 매출 (취소 제외)" Foreground="#777"/>
                                    <TextBlock x:Name="StatsTotalSales" Text="-" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,6" Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="일별 주문 및 매출" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="StatsDailyGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="29" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="*"/>
                                        <DataGridTextColumn Header="주문" Binding="{Binding OrderCount}" Width="48"/>
                                        <DataGridTextColumn Header="매출" Binding="{Binding SalesText}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <Grid Margin="0" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="인기 메뉴 TOP 5" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="StatsTopGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="29" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="상품" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity}" Width="48"/>
                                        <DataGridTextColumn Header="매출" Binding="{Binding SalesText}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="StatsStatusText" Grid.Row="3" Foreground="#855D43" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </TabItem>

                <TabItem Header="주문 취소">
                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="최근 주문 · 취소 및 재고 복구" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" Grid.Row="0"/><Button x:Name="CancelRefreshButton" Content="갱신" Click="CancelRefresh_Click" Style="{StaticResource ToolbarSecondaryButton}" HorizontalAlignment="Right" MinWidth="88" Grid.Row="1"/>
                            </Grid>
                        <DataGrid x:Name="CancelOrderGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" RowHeight="34" FontSize="11" SelectionChanged="CancelOrderGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="주문번호" Binding="{Binding Id}" Width="45"/>
                                <DataGridTextColumn Header="일시" Binding="{Binding CreatedText}" Width="75"/>
                                <DataGridTextColumn Header="구분" Binding="{Binding OrderType}" Width="40"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="40"/>
                                <DataGridTextColumn Header="금액" Binding="{Binding PriceText}" Width="65"/>
                                <DataGridTextColumn Header="주문 상품" Binding="{Binding ItemsText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Style="{StaticResource SoftCardStyle}" Padding="14" Margin="0,12,0,0">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="CancelSelectionText" Text="취소할 주문을 선택하세요. 접수 상태만 취소할 수 있습니다." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,9"/>
                            <Button x:Name="CancelOrderButton" Content="선택 주문 취소 + 재고 복구" Click="CancelOrder_Click" Style="{StaticResource DangerActionButton}" MinWidth="0" IsEnabled="False" HorizontalAlignment="Stretch" FontSize="12"/>
                                </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="3" x:Name="CancelStatusText" Margin="0,10,0,0" Foreground="#855D43" TextWrapping="Wrap"/>
                    </Grid>
                </TabItem>
                <TabItem Header="포인트 회원">
                    <Grid Margin="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="LoyaltyMemberGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns><DataGridTextColumn Header="전화번호" Binding="{Binding Phone}" Width="*"/><DataGridTextColumn Header="보유 포인트" Binding="{Binding PointsText}" Width="120"/></DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="신규 회원 전화번호"/><TextBox x:Name="MemberPhoneBox" MaxLength="11" Height="40" FontSize="20" IsReadOnly="True" Margin="0,6,0,6"/>
                            <UniformGrid Columns="3">
                                <Button Content="1" Tag="1" Click="MemberPhoneKey_Click" Height="40"/><Button Content="2" Tag="2" Click="MemberPhoneKey_Click"/><Button Content="3" Tag="3" Click="MemberPhoneKey_Click"/>
                                <Button Content="4" Tag="4" Click="MemberPhoneKey_Click" Height="40"/><Button Content="5" Tag="5" Click="MemberPhoneKey_Click"/><Button Content="6" Tag="6" Click="MemberPhoneKey_Click"/>
                                <Button Content="7" Tag="7" Click="MemberPhoneKey_Click" Height="40"/><Button Content="8" Tag="8" Click="MemberPhoneKey_Click"/><Button Content="9" Tag="9" Click="MemberPhoneKey_Click"/>
                                <Button Content="전체 삭제" Tag="CLEAR" Click="MemberPhoneKey_Click" Height="40"/><Button Content="0" Tag="0" Click="MemberPhoneKey_Click"/><Button Content="⌫" Tag="BACK" Click="MemberPhoneKey_Click"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="회원 등록" Click="LoyaltyRegister_Click" Style="{StaticResource PrimaryActionButton}" MinWidth="0"/><Button Content="새로 고침" Click="LoyaltyRefresh_Click" Style="{StaticResource SecondaryActionButton}" MinWidth="0"/></UniformGrid>
                            <TextBlock x:Name="LoyaltyAdminStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
